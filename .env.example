# ===================================================================
# KrishiNetra - Environment Variables Configuration (.env)
# ===================================================================
# NOTE: The dashboard currently runs 100% Out-Of-The-Box with ZERO API keys
# required (OpenStreetMap and Native Web Speech TTS are built-in).
# You only need to configure the keys below if connecting LIVE production services.
# ===================================================================

# 1. IMD / Open Weather API (Optional - for live external weather feed)
VITE_IMD_API_KEY=your_imd_api_key_here
VITE_WEATHER_API_BASE_URL=https://api.krishinetra.kosmonyx.gov.in/v1

# 2. SMS Gateway - MSG91 (Optional - for live farmer SMS broadcast)
VITE_MSG91_AUTH_KEY=your_msg91_auth_key_here
VITE_MSG91_SENDER_ID=KRISHI
VITE_MSG91_TEMPLATE_ID=your_dlt_approved_template_id

# 3. WhatsApp Business Cloud API (Optional - Meta Cloud API for live WhatsApp)
VITE_WHATSAPP_API_TOKEN=your_meta_whatsapp_token_here
VITE_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# 4. Mapbox GL / Satellite Imagery (Optional - only if switching from default OpenStreetMap)
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# 5. Environment
VITE_APP_ENV=development
